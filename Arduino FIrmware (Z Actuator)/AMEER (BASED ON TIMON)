void setup()
//-----------------
{
  // Hardware
  for (int i = 2; i < 11; i++) {
    pinMode(i, INPUT_PULLUP);
    delay(10);
    digitalWrite(i,HIGH);
    delay(10);
  }

  pinMode(pull, OUTPUT);
  pinMode(dir, OUTPUT);
  pinMode(13, OUTPUT);

  lcd.init();                      // initialize the lcd
  lcd.backlight();

  // Sonderzeichen
  lcd.createChar(0, bell);// Zeichen Doppelbuchstabe "in"
  lcd.createChar(1, note);
  lcd.createChar(2, clock);
  lcd.createChar(3, toup);
  lcd.createChar(4, todown);
  lcd.createChar(5, up);
  lcd.createChar(6, down);
  lcd.createChar(7, retarrow);
  lcd.home();

Serial.begin(9600);
  inputString.reserve(4);
  //Startanzeige mit Motorschalter
  zeige(2, 1, "HTM Reetz GmbH");
  zeige(1, 2, "AU 21-0-227 R1.33 AMEER");  delay(2500);
  lcd.clear();
  Serial.println("COM Port verbunden");
  
    schaltEmporState = !digitalRead(schaltEmpor);
    schaltHinabState = !digitalRead(schaltHinab); 
  while ((schaltEmporState)||(schaltHinabState))
  { 
    motorSchalter();
    lcd.setCursor(0, 1);
    lcd.print(" Motorschalter auf");
    lcd.setCursor(3,2);
    lcd.print(">Aus< stellen");
  }
  lcd.clear();
  potiStateAlt = analogRead(A0);
  arbeitsGang();
  mittelGang();
  eilGang();

  lcd.setCursor(0, 3);
  lcd.print("F     Pos");
  Timer1.initialize(4285000 / wert); //
  Timer1.attachInterrupt( timerIsr );
}
//___________________________________________________________
void loop()
{

  if (stringComplete) {
    if (inputString.startsWith("E1")){
      Extern = true;
      Run = false;
      count = 0;
      //halt = false;
      lcd.setCursor(19,1);
      lcd.print("E");
      lcd.setCursor(19,2);
      lcd.print("X");
    }
    if (inputString.startsWith("E0")){
      Extern = false;
      Run = false;
      lcd.setCursor(19,1);
      lcd.print(" ");
      lcd.setCursor(19,2);
      lcd.print(" ");
    }    
    if (inputString.startsWith("P")){
       Serial.println(String(count, 4));
    }
    if (inputString.startsWith("R1")){
      Run = true;    
    }
    if (inputString.startsWith("R0")){
      Run = false;    
    }    
    // clear the string:
    inputString = "";
    stringComplete = false;
  }  
 //------ Position Nullen  
  linksState = digitalRead(links);
  if (linksState == 0) {
    count = 0;
    linksState = false;
  }
  //-----  Wertübernahme
  if (halt == true) {
    lcd.noBlink();
    rechtsState = digitalRead(rechts);
    if (rechtsState == 0) {
      validF = true;
      LPosi(1, 3, 4, String(wert) );
      rechtsState = 1;
      if (arbeitState)  Timer1.setPeriod(8570000 / wert);
      if (mittelState)  Timer1.setPeriod(8570000 / wert);
      if (eilState) Timer1.setPeriod(8570 / wert);
    }
  }
  //----- Vorschub Band Hoch
  if (halt == true) {
    hochState = digitalRead(hoch);
    if (hochState == 0) {
      if (mittelState)arbeitsGang();
      if (eilState)mittelGang();
      delay(250);
      hochState = 1;
    }
  }
  //----- Vorschub Band Runter
  if (halt == true) {
    runterState = digitalRead(runter);
    if (runterState == 0) {
      if (mittelState)eilGang();
      if (arbeitState)mittelGang();
      delay(250);
      runterState = 1;
    }
  }
//motorSchalter();
  {

  }
  
  if ((Extern && Run) || !Extern){
  //----  Schalter Empor
  if (haltOben == false) {
    buttonState = digitalRead(schaltEmpor);
      if (!buttonState) {
        lcd.setCursor(19, 0); lcd.printByte(5); //Pfeil empor
        lcd.setCursor(19, 3); lcd.print(" ");
        digitalWrite(dir, true);
        digitalWrite(13,0);
       dirUpState = true; //######
        dirDownState = false;
        buttonState = 1;
        //schaltEmporState = true;
        if (haltEndSch) {
          halt = false;
          haltUnten = false;
          haltEndSch = false;
        }
  }
  }  }
    
  
  else{
    halt = true;
    dirUpState = false;
    }
  if(((Extern)&&(Run))||(!Extern)){ 
 // buttonState = 1;
  //----- Schalter Hinab
  if (haltUnten == false){//************************************
     schaltHinabState = digitalRead(schaltHinab);
    if (!buttonState) {
        lcd.setCursor(19, 3); lcd.printByte(6); // Pfeil hinab
        lcd.setCursor(19, 0); lcd.print(" ");
        digitalWrite(dir, false);
      //  digitalWrite(13,1);
        dirUpState = true;
        dirDownState = false;
       // hinabState = 1;
        schaltHinabState = true;

        if (haltEndSch) {
          halt = false;
          haltOben = false;
          haltEndSch = false;
        }
    }
  }
  else{
    halt = true;
    dirDownState = false;
  }
  
  //-------  Endschalter Oben
  if (dirUpState) {
    endSchObenState = digitalRead(endSchOben);
        if (!endSchObenState) {
          lcd.setCursor(19, 0); lcd.printByte(3);
          //lcd.setCursor(19, 3); lcd.print(" ");
        }
      }
  //------  Endschalter Unten
  if (dirDownState) {
    endSchUntenState = digitalRead(endSchUnten);
        if (!endSchUntenState){
          lcd.setCursor(19, 3); lcd.printByte(4);
          lcd.setCursor(19, 0); lcd.print(" ");
       }
  }
  //------Poti auslesen
  if (halt == true) {
    potiState = analogRead(A0);
    if (abs(potiStateAlt - potiState) > 5) {
      potiStateAlt = potiState;
      if (arbeitState) {
        wert = map(potiState, 0, 1023, 1, 100);
      }
      if (mittelState) {
        wert = map(potiState, 0, 1023, 100, 1000);
      }
      if (eilState) {
        wert = map(  potiState, 0, 1023, 1, 45);
      }
      for(int i=0;i<4;i++)LPosi (13,i,5," ");
      LPosi (14, zeile, 4, String(wert));
   
      lcd.setCursor(13,zeile);
      lcd.print(">");      
      validWert = true;
    }
  }
  LPosi(10, 3, 8, String(count, 3)); 
  delay(200);
  buttonState = 1;
  digitalWrite(13, 0);
  
  motorSchalter();
  }
}

// Ende Loop______________________________________________
void timerIsr()
{
  if (halt == false) {
    if ((dirUpState)&&(endSchObenState)) {
      digitalWrite(pull, HIGH);
      delayMicroseconds(8);
      digitalWrite(pull, LOW);
      count = count + tick;
    }
    if ((dirDownState)&&(endSchUntenState)) {
      digitalWrite(pull, HIGH);
      delayMicroseconds(8);
      digitalWrite(pull, LOW);
      count = count - tick;
    }
  }
  delayMicroseconds(5);
}
// LCD Löschen und Neubeschreiben
void LPosi(int x, int y, int L, String LL)
{
  lcd.setCursor(x, y);
  for (int i = 0; i < L; i++)lcd.print(" ");
  lcd.setCursor(x, y);
  lcd.print(LL);
}
//LCD Beschreiben
void zeige (int x, int y, String txt ) {
  lcd.setCursor(x, y);
  lcd.print(txt);
}
