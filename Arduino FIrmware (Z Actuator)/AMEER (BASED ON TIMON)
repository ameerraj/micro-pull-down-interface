#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <TimerOne.h>

#if defined(ARDUINO) && ARDUINO >= 100
#define printByte(args) write(args);
#else
#define printByte(args) print(args,BYTE);
#endif

uint8_t bell[8]     = {0x10, 0x0, 0x16, 0x15, 0x15, 0x15, 0x15};
uint8_t note[8]     = {0x2, 0x3, 0x2, 0xe, 0x1e, 0xc, 0x0};
uint8_t clock[8]    = {0x0, 0xe, 0x15, 0x17, 0x11, 0xe, 0x0};
uint8_t toup[8]     = {0x1f, 0x4, 0xa, 0x15, 0x4, 0x4, 0x4};
uint8_t todown[8]   = {0x4, 0x4, 0x4, 0x15, 0xa, 0x4, 0x1f};
uint8_t up[8]       = {0x4, 0xa, 0x15, 0x4, 0x4, 0x4, 0x4};
uint8_t down[8]     = {0x4, 0x4, 0x4, 0x4, 0x15, 0xa, 0x4};
uint8_t retarrow[8] = {0x1, 0x1, 0x5, 0x9, 0x1f, 0x8, 0x4};

LiquidCrystal_I2C lcd(0x27, 20, 4);

// Hardware Pins & States
const int links = 9;
boolean linksState = false;
const int hoch = 7;
boolean hochState = false;
const int runter = 10;
boolean runterState = false;
const int rechts = 8;
boolean rechtsState = false;
int motorSchState = 1;
const int endSchOben = 4;
boolean endSchObenState = true;
const int endSchUnten = 5;
boolean endSchUntenState = false;
const int schaltEmpor = 3;
boolean schaltEmporState = false;
const int schaltHinab = 2;
boolean schaltHinabState = false;
const int pull = 11;
const int dir = 12;

// Auxiliary Variables
int buttonState = 1;
int potiState = 0;
int potiStateAlt = 0;

// Specifications & Flags
volatile long Z = 0;
boolean motOn = true;
boolean halt = false;
boolean haltEndSch = false;
boolean haltOben = false;
boolean haltUnten = false;
unsigned long interruptInterval = 42850000;
float count = 0L;
float tick = 1.0 / 7000.0;
boolean arbeitState = true;
boolean mittelState = false;
boolean eilState = false;
boolean validWert = true;
boolean validF = false;
boolean dirUpState = false;   // true = Empor
boolean dirDownState = false; // true = Hinab
boolean endUntenAble = true;
int hinabState = false;
int wert = 0;
int zeile = 0;

String inputString = "";
boolean stringComplete = false;
boolean Extern = false;
boolean Run = false;

void setup() {
  for (int i = 2; i < 11; i++) {
    pinMode(i, INPUT_PULLUP);
    delay(10);
    digitalWrite(i, HIGH);
    delay(10);
  }

  pinMode(pull, OUTPUT);
  pinMode(dir, OUTPUT);
  pinMode(13, OUTPUT);

  lcd.init();
  lcd.backlight();

  // Custom Glyphs
  lcd.createChar(0, bell);
  lcd.createChar(1, note);
  lcd.createChar(2, clock);
  lcd.createChar(3, toup);
  lcd.createChar(4, todown);
  lcd.createChar(5, up);
  lcd.createChar(6, down);
  lcd.createChar(7, retarrow);
  lcd.home();

  Serial.begin(9600);
  inputString.reserve(16);

  zeige(2, 1, "HTM Reetz GmbH");
  zeige(1, 2, "AU 21-0-227 R1.33 A");
  delay(2500);
  lcd.clear();
  Serial.println("COM Port verbunden");

  schaltEmporState = !digitalRead(schaltEmpor);
  schaltHinabState = !digitalRead(schaltHinab);
  while (schaltEmporState || schaltHinabState) {
    motorSchalter();
    lcd.setCursor(0, 1);
    lcd.print(" Motorschalter auf");
    lcd.setCursor(3, 2);
    lcd.print(">Aus< stellen");
  }
  lcd.clear();

  potiStateAlt = analogRead(A0);
  arbeitsGang();
  mittelGang();
  eilGang();

  lcd.setCursor(0, 3);
  lcd.print("F     Pos");
  Timer1.initialize(4285000 / wert);
  Timer1.attachInterrupt(timerIsr);
}

void loop() {
  if (stringComplete) {
    if (inputString.startsWith("E1")) {
      Serial.println("EXTERNAL MODE ENABLED");
      Serial.flush();  // Ensure bytes leave the TX buffer immediately
      Extern = true;
      Run = false;
      halt = true;
      dirUpState = false;
      dirDownState = false;
      count = 0;

      lcd.setCursor(19, 1);
      lcd.print("E");
      lcd.setCursor(19, 2);
      lcd.print("X");
    }

    if (inputString.startsWith("E0")) {
          // Allow disabling external mode ONLY if motor is halted/neutral (N mode)
          if (halt && !Run && !dirUpState && !dirDownState) {
            Serial.println("EXTERNAL MODE DISABLED");
            Serial.flush();
            Extern = false;
            Run = false;
            lcd.setCursor(19, 1);
            lcd.print(" ");
            lcd.setCursor(19, 2);
            lcd.print(" ");
          } else {
            // Reject command and alert the host
            Serial.println("ERROR: CANNOT DISABLE EXTERN WHILE RUNNING. SEND 'N' FIRST.");
            Serial.flush();
          }
        }

    if (inputString.startsWith("P")) {
      Serial.println(String(count, 4));
    }

    // Direction UP + Immediate Run Sequence
    if (inputString.startsWith("U1")) {
      if (Extern) {
        dirUpState = true;
        dirDownState = false;
        digitalWrite(dir, HIGH);

        // Read limit switches before starting motion
        endSchObenState = digitalRead(endSchOben);
        endSchUntenState = digitalRead(endSchUnten);

        if (endSchObenState) {
          Run = true;
          halt = false;
          Serial.println("RUNNING UPWARDS");
          lcd.setCursor(19, 0);
          lcd.printByte(5); // Up arrow
          lcd.setCursor(19, 3);
          lcd.print(" ");
        } else {
          Run = false;
          halt = true;
          Serial.println("ERROR: UPPER LIMIT REACHED");
          lcd.setCursor(19, 0);
          lcd.printByte(3); // Upper limit trip indicator
          lcd.setCursor(19, 3);
          lcd.print(" ");
        }
      }
    }

    // Direction DOWN + Immediate Run Sequence
    if (inputString.startsWith("D1")) {
      if (Extern) {
        digitalWrite(dir, LOW);
        dirUpState = false;
        dirDownState = true;

        // Read limit switches before starting motion
        endSchObenState = digitalRead(endSchOben);
        endSchUntenState = digitalRead(endSchUnten);

        if (endSchUntenState) {
          Run = true;
          halt = false;
          Serial.println("RUNNING DOWNWARDS");
          lcd.setCursor(19, 3);
          lcd.printByte(6); // Down arrow
          lcd.setCursor(19, 0);
          lcd.print(" ");
        } else {
          Run = false;
          halt = true;
          Serial.println("ERROR: LOWER LIMIT REACHED");
          lcd.setCursor(19, 3);
          lcd.printByte(4); // Lower limit trip indicator
          lcd.setCursor(19, 0);
          lcd.print(" ");
        }
      }
    }

    // Speed command format:
    // S1<val> -> 1..100 µm/min (arbeitsGang)
    // S2<val> -> 100..1000 µm/min (mittelGang)
    // S3<val> -> 1..45 mm/min (eilGang)
    if (inputString.startsWith("S") && Extern) {
      char range = inputString.charAt(1);
      int parsedVal = inputString.substring(2).toInt();

      if (range == '1') {
        if (parsedVal >= 1 && parsedVal <= 100) {
          arbeitsGang();
          wert = parsedVal;
          Timer1.setPeriod(8570000UL / wert);
        }
      } else if (range == '2') {
        if (parsedVal >= 100 && parsedVal <= 1000) {
          mittelGang();
          wert = parsedVal;
          Timer1.setPeriod(8570000UL / wert);
        }
      } else if (range == '3') {
        if (parsedVal >= 1 && parsedVal <= 45) {
          eilGang();
          wert = parsedVal;
          Timer1.setPeriod(8570UL / wert);
        }
      }

      // Update speed display on line 3
      if (wert > 0) {
        LPosi(1, 3, 4, String(wert));
      }
    }

    // Neutral / Pause / Hold Command (Replaces R0)
    if (inputString.startsWith("N")) {
      if (Extern) {
        Serial.println("PAUSED/HOLD");
        Run = false;
        halt = true;
        dirUpState = false;
        dirDownState = false;

        lcd.setCursor(19, 0);
        lcd.print(" ");
        lcd.setCursor(19, 3);
        lcd.print(" ");
      }
    }

    inputString = "";
    stringComplete = false;
  }

  // Active limit switch safety trip
  if (dirUpState && !digitalRead(endSchOben)) {
    halt = true;
    Run = false;
    lcd.setCursor(19, 0);
    lcd.printByte(3);
  }

  if (dirDownState && !digitalRead(endSchUnten)) {
    halt = true;
    Run = false;
    lcd.setCursor(19, 3);
    lcd.printByte(4);
  }

  // Position Nullen
  linksState = digitalRead(links);
  if (linksState == 0) {
    count = 0;
    linksState = false;
  }

  // Wertuebernahme
  if (halt == true) {
    lcd.noBlink();
    rechtsState = digitalRead(rechts);
    if (rechtsState == 0) {
      validF = true;
      LPosi(1, 3, 4, String(wert));
      rechtsState = 1;
      if (arbeitState) Timer1.setPeriod(8570000 / wert);
      if (mittelState) Timer1.setPeriod(8570000 / wert);
      if (eilState)    Timer1.setPeriod(8570 / wert);
    }
  }

  // Vorschub Band Hoch
  if (halt == true) {
    hochState = digitalRead(hoch);
    if (hochState == 0) {
      if (mittelState) arbeitsGang();
      if (eilState)    mittelGang();
      delay(250);
      hochState = 1;
    }
  }

  // Vorschub Band Runter
  if (halt == true) {
    runterState = digitalRead(runter);
    if (runterState == 0) {
      if (mittelState) eilGang();
      if (arbeitState) mittelGang();
      delay(250);
      runterState = 1;
    }
  }

  if (!Extern) {
    // Schalter Empor
    if (haltOben == false) {
      buttonState = digitalRead(schaltEmpor);
      if (!buttonState) {
        lcd.setCursor(19, 0);
        lcd.printByte(5);
        lcd.setCursor(19, 3);
        lcd.print(" ");
        digitalWrite(dir, true);
        digitalWrite(13, 0);
        dirUpState = true;
        dirDownState = false;
        buttonState = 1;
        if (haltEndSch) {
          halt = false;
          haltUnten = false;
          haltEndSch = false;
        }
      }
    }

    // Schalter Hinab
    if (haltUnten == false) {
      schaltHinabState = digitalRead(schaltHinab);
      if (!buttonState) {
        lcd.setCursor(19, 3);
        lcd.printByte(6);
        lcd.setCursor(19, 0);
        lcd.print(" ");
        digitalWrite(dir, false);
        dirUpState = true;
        dirDownState = false;
        schaltHinabState = true;

        if (haltEndSch) {
          halt = false;
          haltOben = false;
          haltEndSch = false;
        }
      }
    } else {
      halt = true;
      dirDownState = false;
    }

    // Endschalter Oben Indicator
    if (dirUpState) {
      endSchObenState = digitalRead(endSchOben);
      if (!endSchObenState) {
        lcd.setCursor(19, 0);
        lcd.printByte(3);
      }
    }

    // Endschalter Unten Indicator
    if (dirDownState) {
      endSchUntenState = digitalRead(endSchUnten);
      if (!endSchUntenState) {
        lcd.setCursor(19, 3);
        lcd.printByte(4);
        lcd.setCursor(19, 0);
        lcd.print(" ");
      }
    }

    // Poti auslesen
    if (halt == true) {
      potiState = analogRead(A0);
      if (abs(potiStateAlt - potiState) > 5) {
        potiStateAlt = potiState;
        if (arbeitState) {
          wert = map(potiState, 0, 1023, 1, 100);
        }
        if (mittelState) {
          wert = map(potiState, 0, 1023, 100, 1000);
        }
        if (eilState) {
          wert = map(potiState, 0, 1023, 1, 45);
        }
        for (int i = 0; i < 4; i++) LPosi(13, i, 5, " ");
        LPosi(14, zeile, 4, String(wert));

        lcd.setCursor(13, zeile);
        lcd.print(">");
        validWert = true;
      }
    }

    delay(200);
    buttonState = 1;
    digitalWrite(13, 0);
    motorSchalter();
  }

  // Safety precaution, in case of buffer saturation
  delay(150);
  LPosi(10, 3, 8, String(count, 3));
}

void timerIsr() {
  if (halt == false) {
    if (dirUpState && endSchObenState) {
      digitalWrite(pull, HIGH);
      delayMicroseconds(8);
      digitalWrite(pull, LOW);
      count = count + tick;
    }
    if (dirDownState && endSchUntenState) {
      digitalWrite(pull, HIGH);
      delayMicroseconds(8);
      digitalWrite(pull, LOW);
      count = count - tick;
    }
  }
  delayMicroseconds(5);
}

void LPosi(int x, int y, int L, String LL) {
  lcd.setCursor(x, y);
  for (int i = 0; i < L; i++) lcd.print(" ");
  lcd.setCursor(x, y);
  lcd.print(LL);
}

void zeige(int x, int y, String txt) {
  lcd.setCursor(x, y);
  lcd.print(txt);
}

void arbeitsGang() {
  LPosi(2, 0, 10, "1..100\344/m");
  lcd.printByte(0);
  lcd.print("   ");
  LPosi(1, 3, 4, ">");
  validWert = false;
  arbeitState = true;
  eilState = false;
  mittelState = false;
  zeile = 0;
  for (int i = 0; i < 4; i++) LPosi(13, i, 5, "");
  lcd.setCursor(13, zeile);
  lcd.print(">");
}

void mittelGang() {
  LPosi(0, 1, 10, "100..1000\344/m");
  lcd.printByte(0);
  lcd.print("   ");
  LPosi(1, 3, 4, "");
  validWert = false;
  mittelState = true;
  eilState = false;
  arbeitState = false;
  zeile = 1;
  for (int i = 0; i < 4; i++) LPosi(13, i, 5, "");
  lcd.setCursor(13, zeile);
  lcd.print(">");
}

void eilGang() {
  LPosi(2, 2, 10, "1..45mm/m");
  lcd.printByte(0);
  lcd.print("   ");
  LPosi(1, 3, 4, "");
  validWert = false;
  eilState = true;
  arbeitState = false;
  mittelState = false;
  zeile = 2;
  for (int i = 0; i < 4; i++) LPosi(13, i, 5, "");
  lcd.setCursor(13, zeile);
  lcd.print(">");
}

void motorSchalter() {
  schaltEmporState = !digitalRead(schaltEmpor);
  schaltHinabState = !digitalRead(schaltHinab);

  if (!schaltEmporState && !schaltHinabState) {
    halt = true;
    dirUpState = false;
    dirDownState = false;
    lcd.setCursor(19, 3);
    lcd.print(" ");
    lcd.setCursor(19, 0);
    lcd.print(" ");
    lcd.setCursor(15, zeile);
    motorSchState = 1;
  }
  if (schaltEmporState) {
    dirUpState = true;
    dirDownState = false;
    digitalWrite(dir, true);
    halt = false;
    lcd.setCursor(19, 0);
    lcd.printByte(5);
    motorSchState = 2;
    lcd.noBlink();
  }
  if (schaltHinabState) {
    dirUpState = false;
    dirDownState = true;
    digitalWrite(dir, false);
    halt = false;
    lcd.setCursor(19, 3);
    lcd.printByte(6);
    motorSchState = 3;
    lcd.noBlink();
  }
}

void serialEvent() {
  while (Serial.available()) {
    char inChar = (char)Serial.read();
    inputString += inChar;
    if (inChar == '\n') {
      stringComplete = true;
    }
  }
}
