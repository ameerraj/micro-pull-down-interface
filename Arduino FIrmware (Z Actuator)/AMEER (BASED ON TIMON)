//_______________________________

void motorSchalter()
{   
    //lcd.clear();
    schaltEmporState = !digitalRead(schaltEmpor);
    schaltHinabState = !digitalRead(schaltHinab);
      
    if ((!schaltEmporState)&&(!schaltHinabState))
    {
      halt=true;
      dirUpState = false;
      dirDownState = false;
      lcd.setCursor(19,3);
      lcd.print(" ");
      lcd.setCursor(19,0);
      lcd.print(" ");
      lcd.setCursor(15,zeile);
      motorSchState=1;
    }    
     if (schaltEmporState)
     {
      dirUpState = true; 
      dirDownState = false;
       digitalWrite(dir, true);      
      halt = false;      
      lcd.setCursor(19, 0); lcd.printByte(5); // Pfeil    
      motorSchState = 2;
      lcd.noBlink();
}
     if (schaltHinabState)
     {
      dirUpState = false;
      dirDownState = true; 
       digitalWrite(dir, false);      
      halt = false;   
      lcd.setCursor(19, 3);
      lcd.printByte(6); // Pfeil hinab
      motorSchState = 3;
      lcd.noBlink();
     }
}
void serialEvent() {
  while (Serial.available()) {
    // get the new byte:
    char inChar = (char)Serial.read();
    // add it to the inputString:
    inputString += inChar;
    // if the incoming character is a newline, set a flag so the main loop can
    // do something about it:
    if (inChar == '\n') {
      stringComplete = true;
    }
  }
}     

